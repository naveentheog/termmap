# TermMap needs NO API keys: every model is open-weight and runs locally.
# Everything below is optional. Copy this file to .env only if you need it.

# Hugging Face token, only needed if you pull models through a private mirror
HF_TOKEN=

# Where Hugging Face models are cached
HF_HOME=./hf_cache

# Which GPU to use
CUDA_VISIBLE_DEVICES=0
